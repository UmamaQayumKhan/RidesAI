# Copy this file to .env and fill in your values.

# --- App ---
APP_NAME=AgentDesk
ENVIRONMENT=development
# Use a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./agentdesk.db
# Later, for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentdesk
LOG_LEVEL=INFO

# --- AI (OpenAI) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# Leave empty for OpenAI. Any OpenAI-compatible provider also works, for example Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=
AGENT_MAX_HISTORY=20
AGENT_MAX_TOOL_ROUNDS=6
AGENT_TEMPERATURE=0.2

# --- WhatsApp Cloud API ---
# Public HTTPS address of this server (e.g. your ngrok URL). Shown in Settings as the webhook URL.
PUBLIC_BASE_URL=http://localhost:8000
WHATSAPP_GRAPH_VERSION=v21.0
# Per-business WhatsApp credentials (Phone Number ID, Access Token, App Secret,
# Verify Token) are entered in the dashboard under Agent Settings, not here.
